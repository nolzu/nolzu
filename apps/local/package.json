{
  "name": "nolzu",
  "version": "0.1.0",
  "description": "A local-first kanban board where moving a card starts an AI coding agent on your own machine.",
  "keywords": [
    "kanban",
    "ai",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "mcp",
    "local-first",
    "developer-tools"
  ],
  "license": "FSL-1.1-ALv2",
  "homepage": "https://nolzu.com",
  "bugs": {
    "url": "https://github.com/nolzu/nolzu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nolzu/nolzu.git",
    "directory": "apps/local"
  },
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=23.4.0"
  },
  "files": [
    "build",
    "dist",
    "!**/*.map"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && vite build --config vite.bin.config.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "prepublishOnly": "node scripts/release-check.ts"
  },
  "devDependencies": {
    "@nolzu/core": "workspace:*",
    "@nolzu/protocol": "workspace:*",
    "@nolzu/runner": "workspace:*",
    "@nolzu/skills": "workspace:*",
    "@nolzu/ui": "workspace:*",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  },
  "bin": {
    "nolzu": "./dist/nolzu.js"
  }
}
