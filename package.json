{
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.16.0 || >=23.4.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.21.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm --filter nolzu dev",
    "build": "pnpm --recursive build",
    "test": "vitest run",
    "typecheck": "tsc && pnpm --recursive run check",
    "lint": "eslint . --max-warnings 0",
    "skills:lint": "node packages/skills/src/cli.ts",
    "smoke": "node apps/local/scripts/smoke.ts",
    "pack:check": "node apps/local/scripts/pack-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "eslint-plugin-svelte": "3.23.0",
    "jsdom": "30.0.1",
    "svelte": "5.57.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
